@page "/comprovantes/inconsistencia/{id:int}"
@model ComprovantesApp.Pages.Comprovantes.InconsistenciaModel
@{
    ViewData["Title"] = "Registrar Inconsistência";
    ViewData["Ativo"] = "comprovantes";
}

<h2 class="mb-4">Registrar Inconsistência</h2>

<div class="card">
    <div class="card-body">
        @if (Model.Comprovante is not null)
        {
            <p class="mb-3">
                Comprovante <strong>#@Model.Comprovante.Id - @Model.Comprovante.NumeroDocumento</strong>
                (@Model.Comprovante.Fornecedor?.Nome)
            </p>
        }

        <form method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="ComprovanteId" />

            <div class="mb-3">
                <label asp-for="Motivo" class="form-label">Motivo da inconsistência</label>
                <textarea asp-for="Motivo" class="form-control" rows="4" maxlength="500"
                          placeholder="Explique o motivo da inconsistência..." required></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Registrar inconsistência</button>
                <a href="/Comprovantes" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
